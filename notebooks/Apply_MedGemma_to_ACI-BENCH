= \"assistant\":\n","                assistant_texts.append(text)\n","\n","        user_text = \" \".join(user_texts)\n","        assistant_text = \" \".join(assistant_texts)\n","\n","        # Full text for causal LM\n","        full_text = user_text + tokenizer.eos_token + assistant_text + tokenizer.eos_token\n","        texts.append(full_text)\n","\n","        # Generate token_type_ids: 0 for user, 1 for assistant\n","        # First tokenize separately to get lengths\n","        user_ids = tokenizer(user_text + tokenizer.eos_token)[\"input_ids\"]\n","        assistant_ids = tokenizer(assistant_text + tokenizer.eos_token)[\"input_ids\"]\n","        token_type_ids = [0] * len(user_ids) + [1] * len(assistant_ids)\n","        # Pad to max length later\n","        token_type_ids_list.append(token_type_ids)\n","\n","    # Tokenize full batch\n","    batch = tokenizer(\n","        texts,\n","        return_tensors=\"pt\",\n","        padding=True,\n","        truncation=True,\n","        max_length=768\n","    )\n","\n","    # Prepare labels\n","    labels = batch[\"input_ids\"].clone()\n","    labels[labels == tokenizer.pad_token_id] = -100\n","\n","    # Prepare token_type_ids and pad\n","    max_len = batch[\"input_ids\"].size(1)\n","    padded_token_type_ids = []\n","    for ids in token_type_ids_list:\n","        if len(ids) < max_len:\n","            ids += [0] * (max_len - len(ids))  # pad with 0\n","        else:\n","            ids = ids[:max_len]\n","        padded_token_type_ids.append(ids)\n","    batch[\"token_type_ids\"] = torch.tensor(padded_token_type_ids, dtype=torch.long)\n","\n","    batch[\"labels\"] = labels\n","    return batch"],"metadata":{"id":"83NhaPZWS3XB"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["from trl import SFTConfig\n","\n","training_args = SFTConfig(\n","    output_dir=\"medgemma-4b-it-medical-summarization-lora\",                     # Directory and Hub repository id to save the model to\n","    hub_model_i