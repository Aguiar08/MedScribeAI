esults = bertscore_metric.compute(\n","        predictions=predictions,\n","        references=references,\n","        lang=\"en\",\n","    )\n","\n","    metrics[\"bertscore_f1\"] = sum(bertscore_results[\"f1\"]) / len(bertscore_results[\"f1\"])\n","\n","    bleu_results = bleu_metric.compute(\n","        predictions=predictions,\n","        references=[[ref] for ref in references],\n","    )\n","\n","    metrics[\"bleu\"] = bleu_results[\"bleu\"]\n","\n","    model.eval()\n","    total_loss = 0\n","    total_tokens = 0\n","\n","    with torch.no_grad():\n","        for pred, ref in zip(predictions, references):\n","\n","            inputs = tokenizer(\n","                ref,\n","                return_tensors=\"pt\",\n","                truncation=True,\n","                padding=True,\n","            ).to(model.device)\n","\n","            outputs = model(**inputs, labels=inputs[\"input_ids\"])\n","            loss = outputs.loss\n","\n","            num_tokens = inputs[\"input_ids\"].numel()\n","\n","            total_loss += loss.item() * num_tokens\n","            total_tokens += num_tokens\n","\n","    avg_cross_entropy = total_loss / total_tokens\n","    perplexity = torch.exp(torch.tensor(avg_cross_entropy)).item()\n","\n","    metrics[\"cross_entropy\"] = avg_cross_entropy\n","    metrics[\"perplexity\"] = perplexity\n","\n","    return metrics"],"metadata":{"id":"6YaizICoV2yF","colab":{"base_uri":"https://localhost:8080/","height":177,"referenced_widgets":["0592a40270c14abca459fc570b569d40","a22a890d662b4b919ab61a5d5b8c9818","3d2cc47048534c328c7e699d10587ddd","79255f9387414c87a88403765d3a1cab","bc5d0da2f2234c84ba432a6696282943","e4b197ecbf934073acf62d969092fd65","04cbd2af423f45bebad31e5b97545a66","c25ef18ebb2442f08513c2ed65ec2981","9c1c38d8c5364b609612fd288bfc7859","34056ac460e64f588c4a6f53babe4ac1","daeb93c383a3485c8a828628f3497a5d","4338623c80df4fefacb39b88ab59ae7d","99d0c87adf634dfda3632788633f94fd","466586d4ade8486084b5651d43b86f40","3affa5812d524a3